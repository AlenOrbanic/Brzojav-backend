# .env — Seed Node 1
# Copy this to .env.node2 / .env.node3 and adjust PORT/NODE_ID

PORT=3001
NODE_ID=seed-1

# The public URL this node is reachable at (used in gossip headers)
SELF_URL=http://localhost:3001

# Other seed nodes (for bootstrap)
SEED_1_URL=http://localhost:3001
SEED_2_URL=http://localhost:3002
SEED_3_URL=http://localhost:3003

# How often nodes gossip with each other (ms) — default 30000
GOSSIP_INTERVAL_MS=30000

#Database
MONGODB_URI=mongodb+srv://orbanicadmin:orbanicadmin@cluster0.mscsl9g.mongodb.net/?appName=Cluster0

#Secret jwt
JWT_SECRET=brzojav_super_secret_key_change_this_in_production